# cmake -DIN=<file> -DOUT=<file.cpp> -DNAME=<symbol> -P embed_file.cmake:
# writes <file>'s bytes as `extern const unsigned char NAME[]` + NAME##Size.
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR bytes "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," array "${hex}")
get_filename_component(src "${IN}" NAME)
file(WRITE "${OUT}" "// Generated by cmake/embed_file.cmake from ${src}; do not edit.\n#include <cstddef>\n"
  "extern const unsigned char ${NAME}[] = {${array}};\n"
  "extern const std::size_t ${NAME}Size = ${bytes};\n")
